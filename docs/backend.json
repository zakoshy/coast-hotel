
{
  "entities": {
    "Hotel": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Hotel",
      "type": "object",
      "description": "Represents the hotel itself, containing general information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the hotel."
        },
        "name": {
          "type": "string",
          "description": "Name of the hotel."
        },
        "description": {
          "type": "string",
          "description": "Description of the hotel and its amenities."
        },
        "location": {
          "type": "string",
          "description": "Location of the hotel (e.g., address)."
        },
        "contactNumber": {
          "type": "string",
          "description": "Hotel's contact phone number."
        },
        "email": {
          "type": "string",
          "description": "Hotel's email address.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "location"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "Represents a booking made by a guest.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the booking."
        },
        "hotelId": {
          "type": "string",
          "description": "Reference to Hotel."
        },
        "roomId": {
          "type": "string",
          "description": "Reference to Room."
        },
        "roomType": {
          "type": "string",
          "description": "Type of room booked."
        },
        "guestName": {
          "type": "string",
          "description": "Name of the guest."
        },
        "guestEmail": {
          "type": "string",
          "description": "Email of the guest.",
          "format": "email"
        },
        "checkInDate": {
          "type": "string",
          "description": "Check-in date.",
          "format": "date-time"
        },
        "checkOutDate": {
          "type": "string",
          "description": "Check-out date.",
          "format": "date-time"
        },
        "numberOfGuests": {
          "type": "number",
          "description": "Number of guests."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount."
        },
        "bookingDate": {
          "type": "string",
          "description": "The date when the booking was made.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "Status (confirmed, pending, cancelled).",
          "enum": ["confirmed", "pending", "cancelled"]
        },
        "paymentStatus": {
          "type": "string",
          "description": "Status of payment (paid, pending, refunded).",
          "enum": ["paid", "pending", "refunded"]
        },
        "specialRequests": {
          "type": "string",
          "description": "Special requests from the guest."
        },
        "internalNotes": {
          "type": "string",
          "description": "Notes for internal hotel use."
        }
      },
      "required": [
        "id",
        "hotelId",
        "roomId",
        "guestName",
        "checkInDate",
        "checkOutDate",
        "numberOfGuests",
        "totalAmount",
        "status"
      ]
    },
    "Room": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Room",
      "type": "object",
      "description": "Represents a room in the hotel.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the room."
        },
        "hotelId": {
          "type": "string",
          "description": "Reference to Hotel."
        },
        "roomNumber": {
          "type": "string",
          "description": "Room number."
        },
        "roomType": {
          "type": "string",
          "description": "Type of room (e.g., single, double, suite)."
        },
        "amenities": {
          "type": "string",
          "description": "Room amenities."
        },
        "price": {
          "type": "number",
          "description": "Price per night."
        },
        "maxOccupancy": {
          "type": "number",
          "description": "Maximum guests."
        },
        "description": {
          "type": "string",
          "description": "A detailed description."
        },
        "imageUrls": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "id",
        "hotelId",
        "roomNumber",
        "roomType",
        "price",
        "maxOccupancy"
      ]
    },
    "Revenue": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Revenue",
      "type": "object",
      "description": "Represents revenue generated.",
      "properties": {
        "id": { "type": "string" },
        "hotelId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "source": { "type": "string" }
      },
      "required": ["id", "hotelId", "date", "amount", "source"]
    },
    "AdminUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminUser",
      "type": "object",
      "description": "Represents an admin user.",
      "properties": {
        "id": { "type": "string" },
        "hotelId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" }
      },
      "required": ["id", "hotelId", "username", "email", "role"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/hotels/{hotelId}",
        "definition": {
          "entityName": "Hotel",
          "schema": { "$ref": "#/backend/entities/Hotel" },
          "description": "Stores hotel info."
        }
      },
      {
        "path": "/hotels/{hotelId}/rooms/{roomId}",
        "definition": {
          "entityName": "Room",
          "schema": { "$ref": "#/backend/entities/Room" },
          "description": "Stores room info."
        }
      },
      {
        "path": "/hotels/{hotelId}/bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": { "$ref": "#/backend/entities/Booking" },
          "description": "Stores booking info."
        }
      },
      {
        "path": "/hotels/{hotelId}/revenue/{revenueId}",
        "definition": {
          "entityName": "Revenue",
          "schema": { "$ref": "#/backend/entities/Revenue" },
          "description": "Stores revenue info."
        }
      },
      {
        "path": "/admin_users/{adminUserId}",
        "definition": {
          "entityName": "AdminUser",
          "schema": { "$ref": "#/backend/entities/AdminUser" },
          "description": "Stores admin info."
        }
      }
    ]
  }
}

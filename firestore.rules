rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a Database-Based Access Control (DBAC) model tailored for hotel management. 
     * Access is predicated on the 'AdminUser' entity, which serves as the bridge between a Firebase 
     * Authentication UID and a specific 'Hotel' document.
     *
     * PUBLIC ACCESS:
     * - Guests can read hotel metadata and room details to facilitate bookings.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data;
    }

    function isAdminForHotel(hotelId) {
      return isSignedIn() && getAdminData().hotelId == hotelId;
    }

    function isExistingHotelAdmin(hotelId) {
      return resource != null && isAdminForHotel(hotelId);
    }

    // --- MATCH BLOCKS ---

    match /admin_users/{adminUserId} {
      allow get: if isSignedIn() && request.auth.uid == adminUserId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == adminUserId;
      allow update: if isSignedIn() && request.auth.uid == adminUserId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == adminUserId && resource != null;
    }

    match /hotels/{hotelId} {
      // Allow public to see the hotel info and room listings
      allow get: if true;
      allow list: if true; 
      allow create: if isSignedIn(); 
      allow update: if isExistingHotelAdmin(hotelId);
      allow delete: if isExistingHotelAdmin(hotelId);

      match /rooms/{roomId} {
        allow get, list: if true; // Public can see room details
        allow create: if isAdminForHotel(hotelId) && request.resource.data.hotelId == hotelId;
        allow update: if isExistingHotelAdmin(hotelId) && request.resource.data.hotelId == resource.data.hotelId;
        allow delete: if isExistingHotelAdmin(hotelId);
      }

      match /bookings/{bookingId} {
        allow get, list: if isAdminForHotel(hotelId);
        allow create: if true; // Allow guests to book
        allow update: if isExistingHotelAdmin(hotelId) || (isSignedIn() && resource.data.guestEmail == request.auth.token.email);
        allow delete: if isExistingHotelAdmin(hotelId);
      }

      match /revenue/{revenueId} {
        allow get, list: if isAdminForHotel(hotelId);
        allow create: if isAdminForHotel(hotelId) && request.resource.data.hotelId == hotelId;
        allow update: if isExistingHotelAdmin(hotelId) && request.resource.data.hotelId == resource.data.hotelId;
        allow delete: if isExistingHotelAdmin(hotelId);
      }
    }
  }
}